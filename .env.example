# Siyaq transactional email using Brevo REST API
OTP_MODE=api
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0
FLASK_DEBUG=0
BREVO_API_KEY=
BREVO_SENDER_EMAIL=siyaqProject@hotmail.com
BREVO_SENDER_NAME=Siyaq
# Optional fallback (only when OTP_MODE=smtp)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siyaqProject@hotmail.com

# Required for cross-device email invitations: your public HTTPS site origin
PUBLIC_BASE_URL=https://siyaq-plum.vercel.app

# Production PostgreSQL: set ONLY in Vercel secrets, not in Git
# DATABASE_URL=postgresql://...

# Expert account: optional read-only Release 1 access
EXPERT_USERNAME=
EXPERT_PASSWORD_HASH=

# Required to enable expert registration. Keep private and rotate after onboarding.
EXPERT_REGISTRATION_CODE=

# Private video storage (required for production video uploads)
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary signed browser uploads: configure all three in Vercel.
# API_SECRET must remain server-side; never add it to HTML or JavaScript.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local testing only: show the invitation link instead of emailing it (localhost only). Never set in Vercel.
# INVITE_MODE=demo
