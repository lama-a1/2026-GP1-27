# Siyaq transactional email using Brevo REST API
OTP_MODE=api
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0
FLASK_DEBUG=0
BREVO_API_KEY=
BREVO_SENDER_EMAIL=siyaqProject@hotmail.com
BREVO_SENDER_NAME=Siyaq
# Optional fallback (only when OTP_MODE=smtp)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siyaqProject@hotmail.com

# SMS party invitations (Brevo transactional SMS API)
BREVO_SMS_SENDER=SIYAQ
# Required for cross-device SMS invitations: your public HTTPS site origin
PUBLIC_BASE_URL=
